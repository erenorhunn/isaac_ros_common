# ==============================================================================
# Base Image (run_dev.sh tarafından sağlanır)
# ==============================================================================
ARG BASE_IMAGE
FROM ${BASE_IMAGE}

# ==============================================================================
# 1. Temel Sistem Araçları ve GUI Bağımlılıkları
# ==============================================================================
RUN apt-get update && apt-get install -y --no-install-recommends \
    wget curl git nano libgl1-mesa-glx libglib2.0-0 libxkbcommon-x11-0 libegl1-mesa \
    libdbus-1-3 libxcb-icccm4 libxcb-image0 libxcb-keysyms1 libxcb-randr0 \
    libxcb-render-util0 libxcb-xinerama0 libxcb-xinput0 libxcb-xfixes0 \
    libxcb-cursor0 python3-posix-ipc python3-numpy ros-humble-magic-enum \
    && rm -rf /var/lib/apt/lists/*

# ==============================================================================
# 2. Miniforge (Conda) Kurulumu
# ==============================================================================
ENV CONDA_DIR=/opt/conda
RUN ARCH=$(uname -m) && \
    if [ "$ARCH" = "x86_64" ]; then \
        INSTALLER_URL="https://github.com/conda-forge/miniforge/releases/latest/download/Miniforge3-Linux-x86_64.sh"; \
    elif [ "$ARCH" = "aarch64" ]; then \
        INSTALLER_URL="https://github.com/conda-forge/miniforge/releases/latest/download/Miniforge3-Linux-aarch64.sh"; \
    else \
        echo "Unsupported architecture: $ARCH"; exit 1; \
    fi && \
    wget -q $INSTALLER_URL -O /tmp/miniforge.sh && \
    /bin/bash /tmp/miniforge.sh -b -p $CONDA_DIR && \
    rm /tmp/miniforge.sh && \
    /opt/conda/bin/conda config --set auto_activate_base false && \
    /opt/conda/bin/conda clean --all -y

# ==============================================================================
# 3. 'qt' Ortamının Hazırlanması
# ==============================================================================
RUN /opt/conda/bin/conda create -n qt python=3.10 -y && \
    /opt/conda/envs/qt/bin/pip install \
        PySide6 opencv-python numpy pyyaml \
    && /opt/conda/bin/conda clean --all -y

# ==============================================================================
# 4. Ortam Ayarları (Sistem Geneli)
# ==============================================================================
RUN pip install catkin_pkg empy==3.3.4 lark numpy


# ==============================================================================
# 5. Özel Isaac ROS ve Robot Bağımlılıkları (Rosdep kaynaklı)
# ==============================================================================
# Not: 'ros-humble-nova-carter-bringup' paketi nvblox, nav2, perceptor ve 
# birçok Isaac ROS bağımlılığını (nvidia-compute-560 vb.) otomatik olarak çeker.
RUN apt-get update && apt-get install -y --no-install-recommends \
    ros-humble-foxglove-msgs \
    ros-humble-isaac-ros-h264-decoder \
    ros-humble-isaac-ros-visual-slam \
    ros-humble-nova-carter-bringup \
    ros-humble-usb-cam \
    ffmpeg \
    v4l-utils \
    && rm -rf /var/lib/apt/lists/*

# ==============================================================================
# 6. Bashrc Yapılandırması (En Sonda)
# ==============================================================================
# Ayarları, interaktif bir shell başlatan HER KULLANICI için geçerli olacak
# /etc/bash.bashrc dosyasına ekliyoruz.
RUN echo '' >> /etc/bash.bashrc && \
    echo '# =========================================================' >> /etc/bash.bashrc && \
    echo '# Custom Isaac ROS & Conda Environment Setup' >> /etc/bash.bashrc && \
    echo '# =========================================================' >> /etc/bash.bashrc && \
    echo '' >> /etc/bash.bashrc && \
    echo '# Conda`nın shell fonksiyonlarını yükle (conda activate için şart)' >> /etc/bash.bashrc && \
    echo 'if [ -f /opt/conda/etc/profile.d/conda.sh ]; then' >> /etc/bash.bashrc && \
    echo '    source /opt/conda/etc/profile.d/conda.sh' >> /etc/bash.bashrc && \
    echo 'fi' >> /etc/bash.bashrc && \
    echo '' >> /etc/bash.bashrc && \
    echo '# ROS 2 Humble ortamını yükle' >> /etc/bash.bashrc && \
    echo 'source /opt/ros/humble/setup.bash' >> /etc/bash.bashrc && \
    echo '' >> /etc/bash.bashrc && \
    echo '# Isaac ROS workspace`ini yükle (eğer varsa)' >> /etc/bash.bashrc && \
    echo 'if [ -f /workspaces/isaac_ros-dev/install/setup.bash ]; then' >> /etc/bash.bashrc && \
    echo '    source /workspaces/isaac_ros-dev/install/setup.bash' >> /etc/bash.bashrc && \
    echo 'fi' >> /etc/bash.bashrc && \
    # echo '' >> /etc/bash.bashrc && \
    # echo "# 'qt' conda ortamını otomatik olarak aktive et" >> /etc/bash.bashrc && \
    # echo 'conda activate qt' >> /etc/bash.bashrc && \
    echo '' >> /etc/bash.bashrc && \
    echo '# Conda Python`unun ROS kütüphanelerini görmesi için PYTHONPATH ayarı' >> /etc/bash.bashrc && \
    echo 'export PYTHONPATH=$PYTHONPATH:/opt/ros/humble/lib/python3.10/site-packages:/workspaces/isaac_ros-dev/install/sadek_interfaces/local/lib/python3.10/dist-packages' >> /etc/bash.bashrc